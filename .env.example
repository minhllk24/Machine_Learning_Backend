# =====================================================================
# Retail Demand Forecasting & Inventory Planning - Environment Template
# Copy this file to .env and configure for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# =====================================================================

# Server Configuration
FORECAST_API_ENVIRONMENT=production
FORECAST_API_DEBUG=false
FORECAST_API_HOST=127.0.0.1
FORECAST_API_PORT=8000

# Security Configuration
# Generate a cryptographically secure 256-bit random key in production
FORECAST_API_JWT_SECRET_KEY=forecast-secret-key-prod-2026-auth-hardened
FORECAST_API_JWT_ALGORITHM=HS256
FORECAST_API_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Relational MySQL Database Configuration
# In local dev: point to your local MySQL instance
# In production / Render: point to managed Cloud MySQL or leave empty for offline fallback
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=online_retail_db
MYSQL_POOL_SIZE=5

# Dynamic CORS Allowed Origins
# Comma-separated list of origins or wildcard regex for frontend deployments
FORECAST_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
FORECAST_API_CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
